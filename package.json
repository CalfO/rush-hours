{
  "name": "rushhours",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "predev": "npm run build --workspace @rushhours/domain",
    "dev": "concurrently -n web,api -c blue,green \"npm run start --workspace web\" \"npm run start:dev --workspace api\"",
    "dev:web": "npm run start --workspace web",
    "dev:api": "npm run start:dev --workspace api",
    "prebuild": "npm run build --workspace @rushhours/domain",
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build --workspace @rushhours/domain",
    "test": "npm run test --workspaces --if-present",
    "test:e2e:browser": "npm run e2e --workspace e2e",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace api",
    "prisma:migrate": "npm run prisma:migrate --workspace api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
