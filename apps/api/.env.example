DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# WebAuthn relying party — must match the origin the browser sees for the frontend
# (Codespaces: https://<codespace-name>-3000.app.github.dev ; local dev: http://localhost:3000)
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# Signs the session JWT stored in the httpOnly cookie — change for real deployments
JWT_SECRET="dev-secret-change-me"
