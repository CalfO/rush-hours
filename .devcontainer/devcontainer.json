{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4
  },
  "waitFor": "onCreateCommand",
  "updateContentCommand": "npm install",
  "postCreateCommand": "",
  "postAttachCommand": {
    "server": "npm run dev"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "apps/web/src/App.jsx"
      ]
    }
  },
  "portsAttributes": {
    "3000": {
      "label": "Web",
      "onAutoForward": "openPreview"
    },
    "3001": {
      "label": "API",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [3000, 3001]
}
